PORT=8001
APP_URL=https://chat.tdshift.info
AUTH_BASE_URL=https://auth.tdshift.info
OAUTH_CLIENT_ID=chat-ai
OAUTH_CLIENT_SECRET=change-this-to-match-auth
OAUTH_REDIRECT_URI=https://chat.tdshift.info/auth/callback
# Optional fallback only. MCP servers with dynamic registration will issue their own client_id.
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_SCOPES=mcp mcp:read mcp:write
MCP_OAUTH_UI_LOCALES=en-US
SESSION_SECRET=change-this-to-a-long-random-secret
DATABASE_PATH=./data/chat.db
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=https://chat.tdshift.info
OPENROUTER_APP_NAME=TDShift Chat AI
